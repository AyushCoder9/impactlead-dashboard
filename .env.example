# Postgres (provisioned via Vercel Marketplace -> Neon integration)
DATABASE_URL=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seeded admin account (used once by drizzle/seed.ts, then ignored)
SEED_ADMIN_EMAIL=admin@leaddesk.local
SEED_ADMIN_PASSWORD=

# Upstash Redis (rate limiting) — provisioned via Vercel Marketplace as
# "KV_REST_API_URL"/"KV_REST_API_TOKEN"; a standalone Upstash account uses
# "UPSTASH_REDIS_REST_URL"/"UPSTASH_REDIS_REST_TOKEN" instead. lib/rate-limit.ts
# accepts either naming.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend (new-lead email notifications)
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=

# Cloudflare Turnstile (progressive enhancement — form works without these)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protects the /api/demo/reset cron endpoint from being called by anyone else
CRON_SECRET=
